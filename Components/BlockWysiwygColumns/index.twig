<flynt-component 
  load:on="visible" 
  name="BlockWysiwygColumns"
  class="{% if options.firstComponent %}pt-[10vw] md:pt-[160px]{% endif %}"
  style="
    background-color: {% if options.colorBackground %}{{ options.colorBackground }}{% else %}transparent{% endif %};"
  >
  <div class="boxed !pt-min !pb-[22.5px] lg:!py-[22.5px] w-full fade-in">
    {# <div class="block lg:hidden">
      <h2>{{ headlineTitle|e }}</h2>
    </div> #}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-sm lg:gap-xs align-start justify-start lg:justify-between {% if options.stickyTitle %}stickyTitle{% endif %}">
      {% for column in columns %}
        <div class="column flex {{ column.colStart }} {{ column.colEnd }} lg:row-start-1 lg:row-end-2 [&_.link]:hover:text-orange">
          {% if column.columnLink %}
            <a href="{{ column.columnLink.url }}" {% if column.columnLink.target %} target="{{ column.columnLink.target }}" rel="noreferrer noopener"{% endif %}>
          {% endif %}
          <div class="flex flex-col w-full">
            {% if column.image %}
              <img 
                class="figure-image lazyload w-full aspect-8/5 object-cover mb-xs"
                src="{{ column.image.src }}"
                alt="{{ column.image.alt|e | default('') }}"
                loading="lazy"
                style="opacity: 0; transition: opacity 0.5s ease-in-out;"
                onload="this.style.opacity='1'"
              />
            {% endif %}
            {% if column.videoFile %}
              <video 
                class="w-full aspect-8/5 object-cover mb-xs" 
                autoplay 
                muted 
                loop 
                playsinline
                preload="auto"
                data-video-url="{{ column.videoFile.url }}"
                aria-label="Video"
                role="video">
                <source src="{{ column.videoFile.url }}" type="{{ column.videoFile.mime_type }}">
                {{ __('Your browser does not support the video tag.', 'flynt') }}
              </video>
            {% endif %}
            <div class="wysiwyg">{{ column.contentHtml|e('wp_kses_post') }}</div>
            {% if column.enableNewsletter %}
              {% include 'templates/Partials/_newsletter.twig' with { class: 'mt-xs' } only %}
            {% endif %}
            {% if column.columnLink %}
              <a 
                class="link mt-xs after:content-['↗'] after:text-[0.875rem] after:align-super hover:text-orange" 
                href="{{ column.columnLink.url }}" 
                {% if column.columnLink.target %} target="{{ column.columnLink.target }}" rel="noreferrer noopener"{% endif %}>
                {{ column.columnLink.title }}
              </a>
            {% endif %}
          </div>
          {% if column.columnLink %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</flynt-component> 